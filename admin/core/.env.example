# SECRET_KEY : obligatoire. En production (DEBUG=False) le projet refuse de démarrer si elle est absente
# ou si elle garde la valeur factice ci-dessous. Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here
# DEBUG : False par défaut si la ligne est absente. DEBUG=True est réservé au poste de développement.
DEBUG=True
# ALLOWED_HOSTS : liste séparée par des virgules (production : les noms de domaine exacts, jamais *).
ALLOWED_HOSTS=localhost,127.0.0.1
USE_MYSQL=False
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
VENDOR_MYSQL_DB=
EMAIL_HOST=smtp-relay.brevo.com
# Brevo : identifiant SMTP (Paramètres > SMTP & API > SMTP) et clé SMTP — jamais le mot de passe du compte Brevo
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Expéditeur validé dans Brevo (domaine djona.tech authentifié)
DEFAULT_FROM_EMAIL=Djona <noreply@djona.tech>
# Envoi par l'API Brevo (clé « xkeysib-… », Paramètres > SMTP & API > Clés API) : prioritaire sur le SMTP si renseignée.
# Ne jamais commiter la clé ; l'IP du serveur doit figurer dans les adresses IP autorisées de Brevo.
BREVO_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
# Alertes du suivi en temps réel (commande check_alerts, chaque minute). Rien n'est envoyé sans canal configuré.
# Destinataires e-mail (envoi via Brevo, voir plus haut), séparés par des virgules
ALERT_EMAILS=
# Telegram : jeton du bot (@BotFather) et identifiant de la conversation ou du groupe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pings de santé « site=url », séparés par des virgules (vide = pas de ping)
ALERT_HEALTH_URLS=public=https://djona.tech/
# Seuils (valeurs par défaut) : erreurs 5xx en 5 min, p95 en ms sur 10 min, baisse de trafic en %, délai entre rappels en min
ALERT_5XX_MIN_COUNT=10
ALERT_SLOW_P95_MS=3000
ALERT_TRAFFIC_DROP_PCT=80
ALERT_COOLDOWN_MINUTES=60
