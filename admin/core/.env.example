SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*
USE_MYSQL=False
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
VENDOR_MYSQL_DB=
EMAIL_HOST=smtp-relay.brevo.com
# Brevo : identifiant SMTP (Paramètres > SMTP & API > SMTP) et clé SMTP — jamais le mot de passe du compte Brevo
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Expéditeur validé dans Brevo (domaine djona.tech authentifié)
DEFAULT_FROM_EMAIL=Djona <noreply@djona.tech>
# Envoi par l'API Brevo (clé « xkeysib-… », Paramètres > SMTP & API > Clés API) : prioritaire sur le SMTP si renseignée.
# Ne jamais commiter la clé ; l'IP du serveur doit figurer dans les adresses IP autorisées de Brevo.
BREVO_API_KEY=
REDIS_URL=redis://127.0.0.1:6379
