SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# MySQL (développement et production)
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
# À True uniquement si MySQL est un service managé distant exigeant TLS
# (ex. Aiven). Laisser à False pour un MySQL local (VPS ou poste de dev).
MYSQL_SSL_REQUIRED=False

# E-mail (notifications de commandes, contact, transport) — SMTP Brevo
EMAIL_HOST=smtp-relay.brevo.com
# Brevo : identifiant SMTP (Paramètres > SMTP & API > SMTP) et clé SMTP — jamais le mot de passe du compte Brevo
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Expéditeur validé dans Brevo (domaine djona.tech authentifié)
DEFAULT_FROM_EMAIL=Djona <noreply@djona.tech>
# Envoi par l'API Brevo (clé « xkeysib-… », Paramètres > SMTP & API > Clés API) : prioritaire sur le SMTP si renseignée.
# Ne jamais commiter la clé ; l'IP du serveur doit figurer dans les adresses IP autorisées de Brevo.
BREVO_API_KEY=
# Destinataires internes des notifications (séparés par des virgules)
PARTS_NOTIFY_EMAILS=
TRANSPORT_NOTIFY_EMAILS=
CONTACT_NOTIFY_EMAILS=
